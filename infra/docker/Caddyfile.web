{
	admin off
}

:8080 {
	root * /srv
	# 放在站点层:压缩对 /assets/* 同样生效。之前 encode 只在 SPA handle 里,
	# 静态分包(几百 KB gzip)从不被压缩,弱网首屏直接多付一倍字节。
	encode zstd gzip

	# API traffic belongs to the stable edge, never the replaceable Web container.
	handle /api/* {
		respond "not_found" 404
	}
	# Keep chunk failures distinguishable from the SPA fallback.
	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		header X-Content-Type-Options nosniff
		file_server
	}

	handle {
		# 和一体化镜像一致的隔离头：VAD / 转写用到 SharedArrayBuffer。
		header {
			Cross-Origin-Opener-Policy same-origin
			Cross-Origin-Embedder-Policy require-corp
			X-Content-Type-Options nosniff
			Referrer-Policy no-referrer
		}
		@config path /config.js /sw.js /index.html /
		header @config Cache-Control "no-cache"
		@biliScript path /wangke-bili-bridge.user.js
		header @biliScript Content-Type "text/javascript; charset=utf-8"
		header @biliScript Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
